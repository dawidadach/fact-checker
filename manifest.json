{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Fact Checker",
  "version": "0.7.1",
  "default_locale": "en",
  "key": "",
  "description": "__MSG_extDescription__",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "sidePanel",
    "tabCapture",
    "storage",
    "tabs",
    "webRequest",
    "downloads",
    "unlimitedStorage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "https://auth.openai.com/*",
    "https://api.openai.com/*",
    "http://127.0.0.1/*",
    "https://huggingface.co/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*",
    "https://openrouter.ai/*",
    "https://factchecktools.googleapis.com/*",
    "https://hole.cert.pl/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "version_name": "0.7.1",
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*",
    "<all_urls>"
  ],
  "commands": {
    "fact-check": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "__MSG_cmdFactCheck__"
    }
  }
}
